# Jack Symonds Sway config file (v4)
# Font for window titles. Will also be used by the bar unless a different font
font pango:monospace 8


set $mod Mod4

set $up k
set $down j
set $left h
set $right l

set $terminal alacritty
bindsym $mod+Return exec alacritty --config-file ~/.i3/alacritty/alacritty.toml
# for_window [class="floatingTerm"] floating enable
set $menu rofi
bindsym $mod+Space $menu

# use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod


set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"

## Start i3bar to display a workspace bar (plus the system information i3status
## finds out, if available)
# bar {
#	font pango:DejaVu Sans Mono 8
#	position top
#	status_command i3status -c ~/.i3/status.conf
#}

bar {
    swaybar_command waybar
}

hide_edge_borders smart


include ~/.i3/colors.conf
include ~/.i3/keybindings.conf

input "type:touchpad" {
  natural_scroll enabled
  pointer_accel 0.1
  scroll_factor 0.8
}

output * bg ~/.i3/walls/time_reversal.jpg fill

### Idle configuration
#
# Example configuration:
#
exec swayidle -w \
          timeout 300 'swaylock -f -C ~/.i3/swaylock/config' \
#         timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
          before-sleep 'swaylock -f -C ~/.i3/swaylock/config'
#
# This will lock your screen after 300 seconds of inactivity, then turn off
# your displays after another 300 seconds, and turn your screens back on when
# resumed. It will also lock your screen before your computer goes to sleep.


for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable

# gaps inner all set 10
gaps inner 8
gaps outer 4
